# Environment Configuration
PROJECT_NAME="AI Knowledge Intelligence Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security
SECRET_KEY="development-secret-key-change-this-in-production-use-a-strong-random-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database (PostgreSQL with pgvector)
# For async SQLAlchemy:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/rag_intelligence"
# For sync operations/alembic:
DATABASE_SYNC_URL="postgresql://postgres:postgres@localhost:5432/rag_intelligence"
# Fallback SQLite for offline local unit tests:
SQLITE_DB_PATH="backend/storage/local_rag.db"
USE_SQLITE_FALLBACK=True

# Cache & Message Broker (Redis)
REDIS_URL="redis://localhost:6379/0"
USE_REDIS_FALLBACK=True

# AI Providers (Fill at least one or use mock/local fallback)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
DEFAULT_LLM_PROVIDER="gemini"
DEFAULT_EMBEDDING_PROVIDER="gemini"
EMBEDDING_DIMENSION=1536

# Storage
STORAGE_BACKEND="local"
LOCAL_STORAGE_DIR="backend/storage/uploads"

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000"
